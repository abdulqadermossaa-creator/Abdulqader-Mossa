# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Twilio (WhatsApp via Twilio Sandbox or approved number) ───
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Owner notification phone (WhatsApp) ───────────────────────
OWNER_WHATSAPP_PHONE=+966xxxxxxxxx

# ── Raspberry Pi controller URL (set in edge function env) ────
PI_CONTROLLER_URL=http://192.168.1.50:8000
